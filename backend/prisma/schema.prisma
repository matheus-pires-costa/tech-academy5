generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  cpf   String @unique
}


model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String
  endereco     String?
  agendamentos Agendamento[]
}


model Procedimento {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  preco     Float
  duracao   Int      
  agendamentos Agendamento[]
}


model Agendamento {
  id             Int          @id @default(autoincrement())
  dataHora       DateTime
  status         String       @default("Pendente")
  clienteId      Int
  procedimentoId Int

  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  procedimento   Procedimento @relation(fields: [procedimentoId], references: [id])
}